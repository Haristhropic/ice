# Supabase project connection.
# Copy to .env.local and fill in. The publishable (anon) key is designed to be
# public: all access control happens through Postgres RLS policies, not the key.
# Never put a secret API key or the service_role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<key>
